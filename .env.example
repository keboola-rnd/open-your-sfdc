# =============================================================================
# open-your-sfdc — environment configuration
# =============================================================================
# Copy to `.env` (gitignored) and fill in your Salesforce credentials.
#
# The Flask browser (`make browser`) does NOT need these — it only reads the
# local SQLite DB. These variables are required only for the export/download
# scripts (`make export`, `make files`, `make files-gaps`, `make describe`).
# =============================================================================


# -- Salesforce credentials (required for export / download) ------------------

# Full login email of the SF user whose session will be used for export.
# The user needs "View All Data" to get every SObject, or at minimum read
# access to objects you care about.
SF_USERNAME=your.name@example.com

# Account password. For SSO-only users, create a dedicated API user.
SF_PASSWORD=your-password

# Personal security token — reset via SF: Setup -> Personal Info ->
# Reset My Security Token. SF emails it to you.
# Leave empty if your org has Login IP Ranges that cover your network.
SF_SECURITY_TOKEN=your-security-token

# Domain hint for simple-salesforce:
#   login   -> production / developer org (most common)
#   test    -> sandbox
#   <my>    -> My Domain enabled orgs, e.g. acme (for acme.my.salesforce.com)
SF_DOMAIN=login


# -- Optional overrides -------------------------------------------------------

# Path to the imported SQLite database. Defaults to `data/salesforce_full.db`
# (relative to the repo root). Only useful if you want to point the browser
# at a DB stored elsewhere — e.g. an external SSD for a big export.
# SF_FULL_DB=/path/to/salesforce_full.db
