<?xml version="1.0" encoding="UTF-8"?>
<!--
  Salesforce metadata retrieval manifest for `make sfdx-retrieve`.

  Covers everything that is NOT queryable via standard REST / Tooling SOQL
  and must come through the Metadata API. Each <types> block uses a wildcard
  (*) so the retrieve pulls every component of that type in the org.

  Types intentionally omitted:
    - ApexClass / ApexTrigger / ApexPage / ApexComponent / AuraDefinitionBundle
      (already covered by `make export` — they are queryable sObjects)
    - Report / Dashboard data (data already in CSV via `make export`; only
      their folder structure + XML is added here)
    - Anything org-specific under `StandardValueSet` (comes via *)

  API version 59 = Winter '24. Bump when your target org moves up.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">

    <!-- ====== UI layout and components ====== -->
    <types>
        <members>*</members>
        <name>Layout</name>
    </types>
    <types>
        <members>*</members>
        <name>FlexiPage</name>
    </types>
    <types>
        <members>*</members>
